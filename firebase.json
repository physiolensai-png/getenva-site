{
  "hosting": {
    "public": "public",
    "predeploy": [
      "node scripts/stamp-pages.mjs",
      "node scripts/build-sitemap.mjs",
      "node scripts/build-llms.mjs"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "**/*.@(mp4|jpg|jpeg|png|svg|woff2|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "**/*.md",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/markdown; charset=utf-8"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/llms.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "/llms-full.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/index",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/nutrition",
        "destination": "/meals",
        "type": 301
      },
      {
        "source": "/fitness",
        "destination": "/workouts",
        "type": 301
      },
      {
        "source": "/hyrox",
        "destination": "/workouts",
        "type": 301
      },
      {
        "source": "/Hyrox",
        "destination": "/workouts",
        "type": 301
      },
      {
        "source": "/HYROX",
        "destination": "/workouts",
        "type": 301
      },
      {
        "source": "/envahealthscore",
        "destination": "/your-data#health-score",
        "type": 301
      },
      {
        "source": "/metrics",
        "destination": "/your-data#health-score",
        "type": 301
      },
      {
        "source": "/health-score",
        "destination": "/your-data#health-score",
        "type": 301
      },
      {
        "source": "/biological-age",
        "destination": "/your-data#biological-age",
        "type": 301
      },
      {
        "source": "/sleep-recovery",
        "destination": "/your-data#sleep-recovery",
        "type": 301
      },
      {
        "source": "/recovery-actions",
        "destination": "/your-data#todays-plan",
        "type": 301
      },
      {
        "source": "/Otf",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/OTF",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/Peloton",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/PELOTON",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/tfu-oct2026",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/tfu-oct2026-widgets",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/contact",
        "function": {
          "functionId": "contactForm",
          "region": "us-central1"
        }
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ]
}
